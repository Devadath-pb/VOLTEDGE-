# Voltedge environment configuration
# Copy to .env and adjust for your FastAPI backend.

# Backend REST base URL (FastAPI)
VITE_API_BASE_URL=https://voltedge-api-w499.onrender.com

# WebSocket URL for live battery readings
# The current backend exposes REST/device ingestion endpoints. Set this only
# after a WebSocket endpoint is deployed.
VITE_WS_URL=

# Set to "true" to force demo mode even if a backend is configured
VITE_FORCE_DEMO=false

# Supabase browser client (use the project's public anon key; never use a service-role key here)
VITE_SUPABASE_URL=https://aodbornvsdkskpcbuhve.supabase.co
VITE_SUPABASE_ANON_KEY=
